+  expect(num1(6)).toBe("6,0");
+  expect(num1(1.666)).toBe("1,7");
+  expect(num1(0)).toBe("0,0");
+});
+
+test("per game average", () => {
+  expect(perGame(14, 9)).toBeCloseTo(1.556, 3);
+  expect(perGame(0, 9)).toBe(0);
+  expect(perGame(5, 0)).toBe(0);
