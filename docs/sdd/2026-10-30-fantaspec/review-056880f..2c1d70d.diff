--- /dev/null
+++ b/web/src/squads.test.ts
@@ -0,0 +1,83 @@
+import { decodeShare, encodeShare, loadSelected, loadSquads, saveSelected, saveSquads } from "./squads";
+
+test("share link round trip keeps names and order", () => {
+  const s = { id: "x", name: "FC Ghisleni", players: [{ id: 572, name: "Meret" }, { id: 184, name: "Bernardeschi" }] };
+  expect(decodeShare(encodeShare(s))).toEqual({ ...s, id: expect.any(String) });
+});
+
+test("share link keeps accents, apostrophes and emoji, and is URL safe", () => {
+  const s = { id: "x", name: "Rosa d'Ōro ⚽", players: [{ id: 4317, name: "N'Dicka" }, { id: 1, name: "Milinković-Savić" }] };
+  const param = encodeShare(s);
+  expect(param).toMatch(/^[A-Za-z0-9_-]+$/);
+  expect(decodeShare(param)).toEqual({ ...s, id: expect.any(String) });
+});
+
+test("every decoded share link gets a fresh id", () => {
+  const s = { id: "x", name: "A", players: [] };
+  expect(decodeShare(encodeShare(s))!.id).not.toBe(decodeShare(encodeShare(s))!.id);
+});
+
+test("bad share links return null", () => {
+  const b64 = (v: unknown) => btoa(JSON.stringify(v));
+  const bad = [
+    "",
+    "%%%",
+    btoa("not json"),
+    b64({ n: "x" }),
+    b64({ n: 3, p: [] }),
+    b64({ n: "x", p: [[1]] }),
+    b64({ n: "x", p: [["1", "Meret"]] }),
+    b64({ n: "x", p: [[1.5, "Meret"]] }),
+    b64({ n: "x", p: "Meret" }),
+    b64(null),
+    b64([]),
+    "/w", // not valid UTF-8 once decoded
+  ];
+  for (const param of bad) expect(decodeShare(param)).toBeNull();
+});
+
+test("squads and selection survive a reload", () => {
+  const squads = [{ id: "a", name: "Uno", players: [{ id: 1, name: "Meret" }] }];
+  saveSquads(squads);
+  saveSelected("a");
+  expect(loadSquads()).toEqual(squads);
+  expect(loadSelected()).toBe("a");
+  expect(localStorage.getItem("fantaspec.squads.v1")).not.toBeNull();
+  expect(localStorage.getItem("fantaspec.selected")).toBe("a");
+});
+
+test("nothing stored gives no squads and no selection", () => {
+  expect(loadSquads()).toEqual([]);
+  expect(loadSelected()).toBeNull();
+});
+
+test("corrupted or blocked storage gives no squads", () => {
+  localStorage.setItem("fantaspec.squads.v1", "{broken");
+  expect(loadSquads()).toEqual([]);
+  vi.spyOn(Storage.prototype, "getItem").mockImplementation(() => { throw new Error("blocked"); });
+  expect(loadSquads()).toEqual([]);
+  expect(loadSelected()).toBeNull();
+});
+
+test("blocked storage hides even valid squads, without throwing", () => {
+  saveSquads([{ id: "a", name: "Uno", players: [] }]);
+  saveSelected("a");
+  expect(loadSquads()).toHaveLength(1);
+  vi.spyOn(Storage.prototype, "getItem").mockImplementation(() => { throw new Error("blocked"); });
+  expect(loadSquads()).toEqual([]);
+  expect(loadSelected()).toBeNull();
+});
+
+test("stored squads with the wrong shape are dropped, valid ones kept", () => {
+  const good = { id: "a", name: "Uno", players: [{ id: 1, name: "Meret" }] };
+  localStorage.setItem("fantaspec.squads.v1", JSON.stringify([good, { id: "b" }, { id: "c", name: "X", players: [{ id: "1" }] }, null, 7]));
+  expect(loadSquads()).toEqual([good]);
+  localStorage.setItem("fantaspec.squads.v1", JSON.stringify({ not: "an array" }));
+  expect(loadSquads()).toEqual([]);
+});
+
+test("blocked or full storage never throws on save", () => {
+  vi.spyOn(Storage.prototype, "setItem").mockImplementation(() => { throw new Error("quota"); });
+  expect(() => saveSquads([])).not.toThrow();
+  expect(() => saveSelected("a")).not.toThrow();
+});
diff --git a/web/src/squads.ts b/web/src/squads.ts
new file mode 100644
index 0000000..e25db29
--- /dev/null
+++ b/web/src/squads.ts
@@ -0,0 +1,92 @@
+export type SquadPlayer = { id: number; name: string };
+export type Squad = { id: string; name: string; players: SquadPlayer[] };
+
+const SQUADS_KEY = "fantaspec.squads.v1";
+const SELECTED_KEY = "fantaspec.selected";
+
+// Storage can be missing, blocked, full or hold garbage: every access is guarded and falls back silently.
+
+function readStorage(key: string): string | null {
+  try {
+    return localStorage.getItem(key);
+  } catch {
+    return null;
+  }
+}
+
+function writeStorage(key: string, value: string): void {
+  try {
+    localStorage.setItem(key, value);
+  } catch {
+    // Nowhere to save: the app keeps working with what it has in memory.
+  }
+}
+
+function isSquadPlayer(v: unknown): v is SquadPlayer {
+  const p = v as SquadPlayer | null;
+  return typeof p === "object" && p !== null && Number.isInteger(p.id) && typeof p.name === "string";
+}
+
+function isSquad(v: unknown): v is Squad {
+  const s = v as Squad | null;
+  return typeof s === "object" && s !== null && typeof s.id === "string" && typeof s.name === "string"
+    && Array.isArray(s.players) && s.players.every(isSquadPlayer);
+}
+
+export function newId(): string {
+  // randomUUID only exists in secure contexts (not on a phone opening the dev server over http).
+  return typeof crypto !== "undefined" && typeof crypto.randomUUID === "function"
+    ? crypto.randomUUID()
+    : `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 10)}`;
+}
+
+export function loadSquads(): Squad[] {
+  try {
+    const parsed: unknown = JSON.parse(readStorage(SQUADS_KEY) ?? "[]");
+    return Array.isArray(parsed) ? parsed.filter(isSquad) : [];
+  } catch {
+    return [];
+  }
+}
+
+export function saveSquads(squads: Squad[]): void {
+  writeStorage(SQUADS_KEY, JSON.stringify(squads));
+}
+
+export function loadSelected(): string | null {
+  return readStorage(SELECTED_KEY);
+}
+
+export function saveSelected(id: string): void {
+  writeStorage(SELECTED_KEY, id);
+}
+
+// Share link payload: base64url of the UTF-8 JSON {"n": name, "p": [[id, name], ...]}.
+
+export function encodeShare(squad: Squad): string {
+  const json = JSON.stringify({ n: squad.name, p: squad.players.map(p => [p.id, p.name]) });
+  let binary = "";
+  for (const byte of new TextEncoder().encode(json)) binary += String.fromCharCode(byte);
+  return btoa(binary).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
+}
+
+/** The squad in a share link (with a fresh id), or null when the link is not one of ours. */
+export function decodeShare(param: string): Squad | null {
+  try {
+    const base64 = param.replace(/-/g, "+").replace(/_/g, "/");
+    const bytes = Uint8Array.from(atob(base64), c => c.charCodeAt(0));
+    const payload: unknown = JSON.parse(new TextDecoder("utf-8", { fatal: true }).decode(bytes));
+    const { n, p } = payload as { n?: unknown; p?: unknown };
+    if (typeof n !== "string" || !Array.isArray(p)) return null;
+    const players: SquadPlayer[] = [];
+    for (const entry of p) {
+      if (!Array.isArray(entry)) return null;
+      const player = { id: entry[0], name: entry[1] };
+      if (!isSquadPlayer(player)) return null;
+      players.push(player);
+    }
+    return { id: newId(), name: n, players };
+  } catch {
+    return null;
+  }
+}
