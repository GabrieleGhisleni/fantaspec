 def _rows(items: list) -> list[dict]:
     """Records of a page that must list something."""
     if not items:
         raise ValueError("no rows")
     return [_record(item) for item in items]
 
 
+def _votes_rows(html: str, md: int, overdue: bool) -> list[dict]:
